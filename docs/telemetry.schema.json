{
  "$defs": {
    "Location": {
      "additionalProperties": false,
      "properties": {
        "fix_valid": {
          "title": "Fix Valid",
          "type": "boolean"
        },
        "latitude": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latitude"
        },
        "longitude": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Longitude"
        },
        "speed_kmh": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Kmh"
        },
        "heading_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heading Deg"
        },
        "satellites": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Satellites"
        },
        "hdop": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hdop"
        }
      },
      "required": [
        "fix_valid"
      ],
      "title": "Location",
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "properties": {
        "network_type": {
          "default": "wifi",
          "enum": [
            "wifi",
            "lte",
            "simulator"
          ],
          "title": "Network Type",
          "type": "string"
        },
        "battery_percent": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Battery Percent"
        },
        "external_power": {
          "default": true,
          "title": "External Power",
          "type": "boolean"
        },
        "firmware_version": {
          "default": "unknown",
          "maxLength": 64,
          "title": "Firmware Version",
          "type": "string"
        }
      },
      "title": "Status",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "device_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Device Id",
      "type": "string"
    },
    "sequence_number": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Sequence Number",
      "type": "integer"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "status": {
      "$ref": "#/$defs/Status"
    }
  },
  "required": [
    "schema_version",
    "device_id",
    "sequence_number",
    "recorded_at",
    "location"
  ],
  "title": "Telemetry",
  "type": "object"
}